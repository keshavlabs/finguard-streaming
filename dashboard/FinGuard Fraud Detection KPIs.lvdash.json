{
  "datasets": [
    {
      "name": "latest_alerts",
      "displayName": "Latest Fraud Alerts",
      "queryLines": [
        "SELECT\n",
        "  alert_id,\n",
        "  transaction_timestamp,\n",
        "  customer_name,\n",
        "  merchant_name,\n",
        "  merchant_category,\n",
        "  amount,\n",
        "  currency,\n",
        "  transaction_country,\n",
        "  risk_level,\n",
        "  reason_code\n",
        "FROM\n",
        "  finguard.gold.fraud_card_alert\n",
        "QUALIFY\n",
        "  ROW_NUMBER() OVER (PARTITION BY alert_id ORDER BY transaction_timestamp DESC) = 1\n",
        "ORDER BY\n",
        "  transaction_timestamp DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "daily_trend",
      "displayName": "Daily Txn vs Alerts",
      "queryLines": [
        "WITH alerts AS (\n",
        "  SELECT\n",
        "    to_date(transaction_timestamp) d,\n",
        "    COUNT(DISTINCT alert_id) alert_count,\n",
        "    ROUND(SUM(amount), 0) fraud_amount\n",
        "  FROM\n",
        "    finguard.gold.fraud_card_alert\n",
        "  GROUP BY\n",
        "    1\n",
        "),\n",
        "txns AS (\n",
        "  SELECT\n",
        "    to_date(to_timestamp(transaction_timestamp)) d,\n",
        "    COUNT(*) txn_count,\n",
        "    ROUND(SUM(amount), 0) txn_amount\n",
        "  FROM\n",
        "    finguard.silver.transactions\n",
        "  GROUP BY\n",
        "    1\n",
        ")\n",
        "SELECT\n",
        "  t.d,\n",
        "  t.txn_count,\n",
        "  t.txn_amount,\n",
        "  COALESCE(a.alert_count, 0) alert_count,\n",
        "  COALESCE(a.fraud_amount, 0) fraud_amount\n",
        "FROM\n",
        "  txns t\n",
        "    LEFT JOIN alerts a\n",
        "      ON t.d = a.d\n",
        "ORDER BY\n",
        "  t.d"
      ]
    },
    {
      "name": "alerts_by_risk_level",
      "displayName": "Alerts by Risk Level",
      "queryLines": [
        "SELECT\n",
        "  risk_level,\n",
        "  COUNT(DISTINCT alert_id) alert_count,\n",
        "  ROUND(SUM(amount), 0) fraud_amount\n",
        "FROM\n",
        "  finguard.gold.fraud_card_alert\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  CASE risk_level\n",
        "    WHEN 'CRITICAL' THEN 1\n",
        "    WHEN 'HIGH' THEN 2\n",
        "    WHEN 'MEDIUM' THEN 3\n",
        "    ELSE 4\n",
        "  END"
      ]
    },
    {
      "name": "kpi_totals",
      "displayName": "KPI Totals",
      "queryLines": [
        "SELECT\n",
        "  (\n",
        "    SELECT\n",
        "      COUNT(*)\n",
        "    FROM\n",
        "      finguard.silver.transactions\n",
        "  ) total_transactions,\n",
        "  (\n",
        "    SELECT\n",
        "      ROUND(SUM(amount) / 1000000, 2)\n",
        "    FROM\n",
        "      finguard.silver.transactions\n",
        "  ) total_volume_m,\n",
        "  (\n",
        "    SELECT\n",
        "      COUNT(DISTINCT alert_id)\n",
        "    FROM\n",
        "      finguard.gold.fraud_card_alert\n",
        "  ) fraud_alerts,\n",
        "  (\n",
        "    SELECT\n",
        "      ROUND(\n",
        "        100.0\n",
        "          * COUNT(DISTINCT alert_id)\n",
        "          / (\n",
        "            SELECT\n",
        "              COUNT(*)\n",
        "            FROM\n",
        "              finguard.silver.transactions\n",
        "          ),\n",
        "        2\n",
        "      )\n",
        "    FROM\n",
        "      finguard.gold.fraud_card_alert\n",
        "  ) fraud_rate_pct,\n",
        "  (\n",
        "    SELECT\n",
        "      ROUND(SUM(amount) / 1000000, 2)\n",
        "    FROM\n",
        "      finguard.gold.fraud_card_alert\n",
        "  ) flagged_amount_m,\n",
        "  (\n",
        "    SELECT\n",
        "      COUNT(*)\n",
        "    FROM\n",
        "      finguard.gold.high_value_transactions_alert\n",
        "  ) high_value_alerts"
      ]
    },
    {
      "name": "top_merchants",
      "displayName": "Top Merchants by Fraud",
      "queryLines": [
        "SELECT\n",
        "  merchant_name,\n",
        "  merchant_category,\n",
        "  COUNT(DISTINCT alert_id) alert_count,\n",
        "  ROUND(SUM(amount), 0) fraud_amount\n",
        "FROM\n",
        "  finguard.gold.fraud_card_alert\n",
        "GROUP BY\n",
        "  1,\n",
        "  2\n",
        "ORDER BY\n",
        "  fraud_amount DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "hourly_alerts",
      "displayName": "Hourly Fraud Alerts",
      "queryLines": [
        "SELECT\n",
        "  hour(transaction_timestamp) AS hr,\n",
        "  COUNT(DISTINCT alert_id) alert_count\n",
        "FROM\n",
        "  finguard.gold.fraud_card_alert\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  1"
      ]
    },
    {
      "name": "alerts_by_reason_code",
      "displayName": "Alerts by Reason Code",
      "queryLines": [
        "SELECT\n",
        "  reason_code,\n",
        "  COUNT(DISTINCT alert_id) alert_count,\n",
        "  ROUND(SUM(amount), 0) fraud_amount\n",
        "FROM\n",
        "  finguard.gold.fraud_card_alert\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  alert_count DESC"
      ]
    },
    {
      "name": "top_locations",
      "displayName": "Top Locations by Fraud",
      "queryLines": [
        "SELECT\n",
        "  transaction_country,\n",
        "  transaction_city,\n",
        "  COUNT(DISTINCT alert_id) alert_count,\n",
        "  ROUND(SUM(amount), 0) fraud_amount\n",
        "FROM\n",
        "  finguard.gold.fraud_card_alert\n",
        "GROUP BY\n",
        "  1,\n",
        "  2\n",
        "ORDER BY\n",
        "  fraud_amount DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "alerts_by_merchant_category",
      "displayName": "Alerts by Merchant Category",
      "queryLines": [
        "SELECT\n",
        "  merchant_category,\n",
        "  COUNT(DISTINCT alert_id) alert_count,\n",
        "  ROUND(SUM(amount), 0) fraud_amount\n",
        "FROM\n",
        "  finguard.gold.fraud_card_alert\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  fraud_amount DESC"
      ]
    }
  ],
